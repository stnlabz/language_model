# Normalize text in Git; portable sources and documentation use LF.
* text=auto
*.c text eol=lf
*.h text eol=lf
*.md text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Native Visual Studio and Windows scripts use CRLF in working copies.
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Treat binary assets as binary if intentionally added.
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.exe binary
*.dll binary
*.lib binary
*.pdb binary
